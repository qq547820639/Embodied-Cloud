# Full workspace image: Isaac Sim 6.0.1 + Isaac Lab 3.0.0 Beta 2 + code-server.
# NVIDIA base image and Isaac Sim components remain governed by NVIDIA license terms.
#
# 钉 digest 而不是只留 tag：`6.0.1` 是可移动的标签，同一份配方两次构建可能拿到
# 不同的层。digest 由 nvcr.io 本身解析（匿名 pull 令牌即可，**不需要 NGC 凭据**——
# 凭据只在拉取层字节时需要），实测读数：
#   HEAD /v2/nvidia/isaac-sim/manifests/6.0.1
#     → docker-content-digest: sha256:783444c7…30aa9
#     → content-type: …manifest.list.v2+json, content-length: 743
#   GET 同一地址的 body 重算 sha256 与该 header 一致（两条独立读数吻合）
#   子清单：linux/amd64 sha256:b1c542b2…、linux/arm64 sha256:20269735…
# 钉的是 manifest list（多架构索引）而非单个平台清单，所以 amd64 GPU 主机与
# arm64 本机都能按平台解析到各自的子清单。tag 保留只为可读性：`name:tag@digest`
# 形式由本机 `docker build` 实测接受（进入解析并按 digest 开始拉层）。
FROM nvcr.io/nvidia/isaac-sim:6.0.1@sha256:783444c706538aa76cf5126e911ddc5e618779e6105305ad4af4260362a30aa9

USER root
ARG CODE_SERVER_VERSION=4.130.0
ARG ISAACLAB_REF=v3.0.0-beta2.patch1
# 上游 v4.130.0 的 release 只发布 tar.gz/rpm/deb 资产，既没有 SHA256SUMS.txt
# （下载该路径实测返回 "Not Found"），release notes 里也没有校验表，因此下面的
# 摘要来自本机对官方 CDN 制品的实算（字节数与 GitHub API 报告的资产大小逐一对齐：
# amd64 201284549、arm64 197540112）。它防的是"后续构建拿到被替换/截断的制品"，
# 不构成第三方背书。
ARG CODE_SERVER_SHA256_AMD64=3de23052e34fa705b3817efa66201cbc8d8ba6615b4cd03120c39bfc0ae1b7ab
ARG CODE_SERVER_SHA256_ARM64=795366c40d0b32bc6fbbedf8dc992f9767a6125cc6dce965766c5f79e06bb725
# tag 可被 force push 移动，`--branch` 不保证两次构建拿到同一份代码：钉到 commit。
# v3.0.0-beta2.patch1 → ffff603e…（两个独立来源核对：GitHub refs API 与
# `git ls-remote` 同一 sha；该 tag 是 lightweight tag，直接指向 commit）。
ARG ISAACLAB_COMMIT=ffff603eafc6b74264a5261cc0183d6a65390d78

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl git tini \
    && rm -rf /var/lib/apt/lists/*

RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in amd64) cs_arch=amd64; cs_sha="$CODE_SERVER_SHA256_AMD64";; arm64) cs_arch=arm64; cs_sha="$CODE_SERVER_SHA256_ARM64";; *) echo "unsupported arch: $arch"; exit 1;; esac \
    && curl -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-${cs_arch}.tar.gz" -o /tmp/code-server.tgz \
    && echo "${cs_sha}  /tmp/code-server.tgz" | sha256sum -c - \
    && tar -xzf /tmp/code-server.tgz -C /opt \
    && ln -s "/opt/code-server-${CODE_SERVER_VERSION}-linux-${cs_arch}/bin/code-server" /usr/local/bin/code-server \
    && rm /tmp/code-server.tgz

RUN git clone --depth 1 --branch "${ISAACLAB_REF}" https://github.com/isaac-sim/IsaacLab.git /workspace/IsaacLab \
    && test "$(git -C /workspace/IsaacLab rev-parse HEAD)" = "${ISAACLAB_COMMIT}" \
    && cd /workspace/IsaacLab \
    && ./isaaclab.sh --install

COPY runtime/workspace-entrypoint.sh /usr/local/bin/embodiedcloud-workspace
RUN chmod +x /usr/local/bin/embodiedcloud-workspace \
    && mkdir -p /workspace/project /workspace/home /home/isaac/.local/share/code-server \
    && chown -R 1234:1234 /workspace /home/isaac || true

ENV HOME=/workspace/home \
    IDE_PORT=18000 \
    LIVESTREAM=0 \
    PUBLIC_IP=127.0.0.1

USER 1234:1234
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/embodiedcloud-workspace"]
