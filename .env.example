# --- runtime ---
EMBODIEDCLOUD_PROVIDER=mock
EMBODIEDCLOUD_DATABASE_URL=sqlite:///./embodiedcloud.db
EMBODIEDCLOUD_PUBLIC_BASE_URL=http://127.0.0.1:8000
EMBODIEDCLOUD_BIND_HOST=0.0.0.0
EMBODIEDCLOUD_BIND_PORT=8000

# 开发便利：true 时启动自动 create_all（生产 compose 应设为 false 并走 alembic 迁移）
EMBODIEDCLOUD_AUTO_CREATE_TABLES=true

# --- workspace ---
EMBODIEDCLOUD_WORKSPACE_ROOT=/tmp/embodiedcloud-workspaces
EMBODIEDCLOUD_WORKSPACE_IMAGE=embodiedcloud/isaaclab-workspace:0.1.0
EMBODIEDCLOUD_HOST_PUBLIC_IP=127.0.0.1
EMBODIEDCLOUD_IDE_PORT_START=18000
EMBODIEDCLOUD_IDE_PORT_END=18999
EMBODIEDCLOUD_EULA_ACCEPTED=false
EMBODIEDCLOUD_PRIVACY_CONSENT=false
# 预留：当前未启用（缺 runtime 活动信号），后续接入 IDE/流连接活动检测后生效
EMBODIEDCLOUD_DEFAULT_IDLE_TIMEOUT_MINUTES=60
# §9：provision readiness 等待超时（秒）
EMBODIEDCLOUD_PROVISION_READY_TIMEOUT_SECONDS=120

# --- auth ---
EMBODIEDCLOUD_SESSION_TTL_HOURS=168
# §S-1: 密码 pepper。生产（provider != mock）**必须**显式配置，否则控制面拒绝启动
# （fail-closed，禁止退化为空盐前缀）；mock/本地开发可留空。
# EMBODIEDCLOUD_PASSWORD_PEPPER=
# §13: workspace 凭据加密密钥（Fernet key 来源）。
# 生产（provider != mock）**必须**显式配置，否则控制面拒绝启动。
# 变更密钥会导致存量 enc: 密文无法解密（fail closed，不返回密文当密码）。
# EMBODIEDCLOUD_WORKSPACE_CREDENTIAL_KEY=

# --- billing（§12 / §17 / §18）---
# 生产建议开启启动预授权：可用额度（个人+组织毛余额 − 已圈住的 pending hold）
# 必须 ≥ 最低启动授权（N 分钟 × 60 credits）
# EMBODIEDCLOUD_BILLING_ENFORCE_PREAUTHORIZATION=false
# EMBODIEDCLOUD_BILLING_MINIMUM_LAUNCH_MINUTES=5
# pending hold 的存活时长；控制面在 hold 与结算之间崩溃时，超时由 worker 周期扫描
# 回收（RUNNING 的段不回收，等结算转正）。泄漏窗口以该值为界，方向是少报可用额。
# EMBODIEDCLOUD_BILLING_HOLD_TTL_MINUTES=60

# --- observability ---
EMBODIEDCLOUD_LOG_JSON=false
EMBODIEDCLOUD_LOG_LEVEL=INFO

# --- warm pool ---
EMBODIEDCLOUD_WARM_POOL_ENABLED=false
EMBODIEDCLOUD_WARM_POOL_SIZE=1
# 给交互式启动预留几张卡（0=不预留）。池子会按 size × 启用模板数 补位，
# 这个数逼近舰队容量时把它调大，否则用户请求会抢不到卡（实测见 docs/SUPPLY_CHAIN.md）。
EMBODIEDCLOUD_WARM_POOL_RESERVE_SLOTS=0

# --- k8s provider ---
EMBODIEDCLOUD_K8S_NAMESPACE=embodiedcloud
EMBODIEDCLOUD_K8S_IN_CLUSTER=false
# K8s capacity reservation 的 GPU 显存粒度（MB）
EMBODIEDCLOUD_K8S_GPU_MEMORY_MB=24576
# kubeconfig 路径；留空 = SDK 默认解析（$KUBECONFIG 或 ~/.kube/config）。
# 注意：kubernetes SDK 在进程 import 时就把 KUBECONFIG 固化成常量，进程起来之后再
# 改这个环境变量不会生效——要指路就用本项（或让环境先于进程存在）。
# EMBODIEDCLOUD_K8S_KUBECONFIG=/etc/embodiedcloud/kubeconfig

# --- 对象存储（§21）---
# local = 产物落 EMBODIEDCLOUD_WORKSPACE_ROOT；s3 = S3 兼容对象存储（生产）。
# backend=s3 且下面四项不全时，装配直接抛 BLOCKED_EXTERNAL_DEPENDENCY 拒绝启动，
# 不会静默回退 local（回退会让产物落在控制面文件系统，而 Artifact.store_name 仍记 s3）。
EMBODIEDCLOUD_ARTIFACT_BACKEND=local
# EMBODIEDCLOUD_ARTIFACT_S3_BUCKET=embodiedcloud-artifacts
# 自建 MinIO/RustFS/VersityGW 填其 http 端点；留空 = 走 AWS 官方端点
# EMBODIEDCLOUD_ARTIFACT_S3_ENDPOINT_URL=http://127.0.0.1:9000
# EMBODIEDCLOUD_ARTIFACT_S3_ACCESS_KEY_ID=
# EMBODIEDCLOUD_ARTIFACT_S3_SECRET_ACCESS_KEY=
